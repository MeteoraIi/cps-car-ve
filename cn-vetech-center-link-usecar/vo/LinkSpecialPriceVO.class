     */
    public void setGysbh(String gysbh) {
        this.gysbh = gysbh;
    }
    /**
     * 获取供应商编号
     * @return gysmc 供应商编号
     */
    public String getGysmc() {
        return gysmc;
    }
    /**
     * 设置供应商编号
     * @param gysmc 供应商编号
     */
    public void setGysmc(String gysmc) {
        this.gysmc = gysmc;
    }
    /**
     * 获取车型组编号
     * @return cxzbh 车型组编号
     */
    public String getCxzbh() {
        return cxzbh;
    }
    /**
     * 设置车型组编号
     * @param cxzbh 车型组编号
     */
    public void setCxzbh(String cxzbh) {
        this.cxzbh = cxzbh;
    }

        /**
     * 获取车型组名称
     * 2017年12月26日10:48:14 这个字段的值已作废，新CPS会通过cxzbh去检索
     * @return cxzmc 车型组名称
     */
    @Deprecated
    public String getCxzmc() {
        return cxzmc;
    }
    /**
     * 设置车型组名称
