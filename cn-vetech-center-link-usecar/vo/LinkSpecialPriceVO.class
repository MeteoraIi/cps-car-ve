    }

    public void setDestinationChangeable(String destinationChangeable) {
        this.destinationChangeable = destinationChangeable;
    }

    public String getSupplierBookType() {
        return supplierBookType;
    }

    public void setSupplierBookType(String supplierBookType) {
        this.supplierBookType = supplierBookType;
    }

    public String getBrandIconUrl() {
        return brandIconUrl;
    }

    public void setBrandIconUrl(String brandIconUrl) {
        this.brandIconUrl = brandIconUrl;
    }

    public String getCorpId() {
        return corpId;
    }

    public void setCorpId(String corpId) {
        this.corpId = corpId;
    }

    public String getZws() {
        return zws;
    }

    public void setZws(String zws) {
        this.zws = zws;
    }

    /**
     * 获取供应商编号
     * @return gysbh 供应商编号
     */
