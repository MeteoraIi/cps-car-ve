    }

    public void setShowYkjFlag(String showYkjFlag) {
        this.showYkjFlag = showYkjFlag;
    }

    public String getSfykj() {
        return sfykj;
    }

    public void setSfykj(String sfykj) {
        this.sfykj = sfykj;
    }

    public String getYsGysmc() {
        return ysGysmc;
    }

    public void setYsGysmc(String ysGysmc) {
        this.ysGysmc = ysGysmc;
    }

    public String getYsGysbh() {
        return ysGysbh;
    }

    public void setYsGysbh(String ysGysbh) {
        this.ysGysbh = ysGysbh;
    }

    public String getCpsCacheId() {
