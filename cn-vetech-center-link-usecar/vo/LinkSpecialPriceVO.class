    /**
     * 实际供应商编号
     */
    @ApiModelProperty(value = "实际供应商编号", dataType = "string")
    private String actualSupplierNo;
    /**
     * 可修改的次数
     */
    private String modifyDestCount;

    public String getModifyDestCount() {
        return modifyDestCount;
    }

    public void setModifyDestCount(String modifyDestCount) {
        this.modifyDestCount = modifyDestCount;
    }

    public String getActualSupplierNo() {
