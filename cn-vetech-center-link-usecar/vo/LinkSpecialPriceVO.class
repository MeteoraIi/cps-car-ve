package cn.vetech.center.link.usecar.vo;

import io.swagger.annotations.ApiModelProperty;
import org.vetech.core.modules.utils.mapper.JsonMapper;

import java.math.BigDecimal;

/**
 * 具体车型组询价结果
 * Created by vetech on 2017/10/16.
 * @author zhouyan
 */
public class LinkSpecialPriceVO {
    /**供应商编号**/
    private String gysbh;
    /**供应商编号**/
    private String gysmc;
    /**车型组编号**/
    private String cxzbh;
    /**车型组名称2017年12月26日10:48:14 这个字段的值已作废，新CPS会通过cxzbh去检索**/
    private String cxzmc;
    /**外部(供应商)车型组编号**/
    private String wbcxzbh;
    /**外部(供应商)车型组名称**/
    private String wbcxzmc;
    /**报价**/
    private BigDecimal ygje;
    /**CPMS）产品描述**/
    private String cpms;
    /**价格md5,通过 新的预估价接口获得**/
    private String jgmd5;
    /**计价模式类别：201 专车，301快车*/
    private String jjmslb;
    /**出发地经度(值大的)**/
    private String cfdx;
    /**出发地维度(值小的)**/
    private String cfdy;
    /**目的地经度(值大的)**/
    private String mddx;
    /**目的地维度(值小的)**/
    private String mddy;
    /**座位数**/
    private String zws;
    /**真实供应商名称**/
    private String corpId;
    /**
     * 车型图标名称
     */
