    /**
     * 供应商是否可修改目的地标识，0-不可修改 1-可修改
     */
    private String destinationChangeable;
    /**
     * 预估价格明细
     */
    private String priceDetail;

    private String cpsCacheId;

    /**
     *  原始供应商名称
     */
    private String ysGysmc;
    /**
     *  原始供应商编号
     */
    private String ysGysbh;

    private String sfykj;

    /**
     * 展示一口价标识，滴滴特有 0：不展示，1：展示
     */
