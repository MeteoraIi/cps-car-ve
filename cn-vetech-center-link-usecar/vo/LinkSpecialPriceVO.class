     * @param cxzmc 车型组名称
     */
    @Deprecated
    public void setCxzmc(String cxzmc) {
        this.cxzmc = cxzmc;
    }
    /**
     * 获取(CPMS）产品描述
     * @return cpms (CPMS）产品描述
     */
    public String getCpms() {
        return cpms;
    }
    /**
     * 设置(CPMS）产品描述
     * @param cpms (CPMS）产品描述
     */
    public void setCpms(String cpms) {
        this.cpms = cpms;
    }
    /**
     * 获取201专车，301快车
